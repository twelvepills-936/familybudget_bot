# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=expenses
POSTGRES_USER=expenses
POSTGRES_PASSWORD=secret

# ── Telegram Bot ──────────────────────────────────────────────────────────────
# Получите токен у @BotFather в Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Опциональный HTTP/SOCKS5 прокси, если Telegram заблокирован (например: http://host:port)
PROXY_URL=

# ── LLM Provider (OpenAI-совместимый API) ──────────────────────────────────────
# OpenAI:  LLM_BASE_URL=https://api.openai.com/v1  LLM_MODEL=gpt-4o-mini
# Groq:    LLM_BASE_URL=https://api.groq.com/openai/v1  LLM_MODEL=llama-3.1-8b-instant
# Ollama:  LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_API_KEY=ollama  LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini
